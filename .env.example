# Castle Quartermaster settings. Copy this to .env; .env is ignored by git, so the token never leaves this machine.
# Discord developer portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Server id(s), comma-separated for more than one (right-click the server icon -> Copy Server ID; needs Developer Mode on in
# User Settings -> Advanced). Slash commands show up there right away.
GUILD_ID=
